# Local/private AI (default). No API key or per-query charges.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Keeps memory bounded on a 16 GB RAM / 4 GB VRAM machine.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
OLLAMA_KEEP_ALIVE=5m

# Optional cloud provider. Set AI_PROVIDER=gemini and provide a key to enable it.
# Gemini is also required for the optional Google Search grounding feature.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.5-flash"

# Edit request parser: auto (LLM with rules fallback), llm, or rules.
EDIT_PARSER=auto

# Optional hosted-app URL for self-referential links and callbacks.
APP_URL="MY_APP_URL"
